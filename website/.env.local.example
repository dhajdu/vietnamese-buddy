# Copy to .env.local and fill in. Never commit .env.local itself.
#
# Every process.env.* the code reads (app, lib, components, scripts, proxy.ts,
# next.config.ts) and nothing else. Nothing checks this automatically: if you add
# or remove an env read, update this file in the same change.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The first two are public by design and reach the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Service role: admin pages, the landing pages' settings read, timezone sync, seed script.
# Server-side only, never NEXT_PUBLIC. The old name SUPABASE_SECRET is still read as a fallback.
SUPABASE_SECRET_KEY=sb_secret_...

# ── Site ────────────────────────────────────────────────────────────────────
# Used for auth email links, Stripe return URLs and canonical/OG URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # production is https://www.vietnamese-buddy.com

# ── AI: lesson generation (server-side only) ────────────────────────────────
# The model normally comes from admin settings (app_settings). The provider decides which key is read:
#   anthropic/…  → ANTHROPIC_API_KEY
#   openai/…     → OPENAI_API_KEY
#   openrouter/… → OPENROUTER_API_KEY
# Used only when a caller passes no model. Every current caller passes one, so this is a last resort.
AI_MODEL=anthropic/claude-sonnet-5
ANTHROPIC_API_KEY=sk-ant-...
# Also the voice key for pairs whose TTS provider is OpenAI.
OPENAI_API_KEY=
# openrouter.ai/keys → Create Key. Starts sk-or-v1-. For testing open-weight models.
OPENROUTER_API_KEY=

# ── Voice: Southern Vietnamese TTS (server-side only) ───────────────────────
# console.fpt.ai. Text-to-Speech must be activated on the key or calls return 403.
# Without a working key the app falls back to the browser's own Vietnamese voice.
FPT_AI_API_KEY=
# FPT voice name for the Vietnamese target voice.
TTS_VOICE=lannhi

# ── Stripe: Talent Edge LLC account (server-side only) ──────────────────────
# Production reads the LIVE values; everywhere else reads TEST and falls back to LIVE.
#   Test keys      → Developers → API keys, test mode on
#   Webhook secret → stripe listen --forward-to localhost:3000/api/stripe/webhook
# Price ids are NOT here: they live in the plans table so admin can switch them.
STRIPE_SECRET_KEY=sk_live_...
STRIPE_SECRET_TEST_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_TEST_SECRET=whsec_...

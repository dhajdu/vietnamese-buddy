# Copy to .env.local and fill in. Never commit .env.local itself.
#
# This file is the authoritative list — CI checks that every process.env.*
# the app reads appears here. If you add a new env var to the code, add it here
# in the same commit.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The first two are public by design and reach the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-side only: seed script, admin pages. Never NEXT_PUBLIC.
SUPABASE_SECRET_KEY=sb_secret_...
# Database password, used only by `supabase link` / `db push`.
SUPABASE_PASSWORD=

# ── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # production is https://www.vietnamese-buddy.com

# ── AI: lesson generation (server-side only) ────────────────────────────────
# "<provider>/<model>". The provider decides which key is read.
#   anthropic/…  → ANTHROPIC_API_KEY
#   openai/…     → OPENAI_API_KEY
#   openrouter/… → OPENROUTER_API_KEY
# Fallback when app_settings has no row.
AI_MODEL=anthropic/claude-sonnet-5
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=
# openrouter.ai/keys → Create Key. Starts sk-or-v1-. For testing open-weight models.
OPENROUTER_API_KEY=

# ── Voice: Southern Vietnamese TTS (server-side only) ───────────────────────
# console.fpt.ai. Text-to-Speech must be activated on the key or calls return 403.
# Without a working key the app falls back to the browser's own Vietnamese voice.
FPT_AI_API_KEY=
TTS_VOICE=lannhi

# ── Stripe: Talent Edge LLC account (server-side only) ──────────────────────
# Dev reads the TEST keys, production reads the LIVE ones.
#   Test keys      → Developers → API keys, test mode on
#   Webhook secret → stripe listen --forward-to localhost:3000/api/stripe/webhook
# Price ids are NOT here: they live in app_settings so admin can switch them.
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_TEST_KEY=pk_test_...
STRIPE_SECRET_TEST_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_WEBHOOK_TEST_SECRET=whsec_...

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM="Vietnamese Buddy <hello@vietnamese-buddy.com>"

# ── Learner defaults ────────────────────────────────────────────────────────
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh

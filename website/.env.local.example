# Copy to .env.local and fill in. Never commit .env.local itself.
#
# This file is the authoritative list — CI checks that every process.env.*
# the app reads appears here. If you add a new env var to the code, add it here
# in the same commit.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. Both values are public by design and are sent to
# the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Site URL ────────────────────────────────────────────────────────────────
# The public origin: auth email redirects and SEO metadata. In production this
# is your real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase, server-side only ──────────────────────────────────────────────
# Project Settings → API Keys → secret key. Used by the seed script and admin
# tasks. Never NEXT_PUBLIC. SUPABASE_PASSWORD is the database password, used
# only by `supabase link` / `db push`.
SUPABASE_SECRET_KEY=sb_secret_...   # SUPABASE_SECRET is accepted as an alias
SUPABASE_PASSWORD=

# ── AI (lesson generation, server-side only) ────────────────────────────────
# "<provider>/<model>". The provider picks which key is read. Never NEXT_PUBLIC.
AI_MODEL=anthropic/claude-opus-5
ANTHROPIC_API_KEY=sk-ant-...
# Only needed if AI_MODEL=openai/...
OPENAI_API_KEY=

# ── Learner defaults ────────────────────────────────────────────────────────
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
